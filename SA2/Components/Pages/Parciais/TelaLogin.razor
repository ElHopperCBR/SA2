<main class="corpo-pagina">
    <!-- ================================================================== -->
    <!-- TELA 1: LOGIN -->
    <!-- ================================================================== -->
    <div id="tela-login" class="tela-de-login">
        <div class="login-container">
            <div class="login-header">
                <div class="login-icon-wrapper">
                    <i data-lucide="wifi" class="fa-solid fa-wifi"></i>
                </div>
                <h1 class="login-title">Acesso ao WI-FI</h1>
                <p class="login-subtitle">Sistema de Gestão Wi-Fi</p>
            </div>

            <form id="form-login" class="login-form">
                <!-- TODO: Implementar validação de campos vazios -->
                <div class="form-group">
                    <label for="email" class="form-label">E-mail Institucional</label>
                    <div class="input-wrapper">
                        <div class="input-icon">
                            <i data-lucide="mail" class="h-5 w-5 text-gray-400"></i>
                        </div>
                        <input type="email" id="email" class="form-input" placeholder="admin@sp.senai.br">
                    </div>
                </div>

                <div class="form-group">
                    <label for="senha" class="form-label">Senha</label>
                    <div class="input-wrapper">
                        <div class="input-icon">
                            <i data-lucide="lock" class="h-5 w-5 text-gray-400"></i>
                        </div>
                        <input type="password" id="senha" class="form-input" placeholder="••••••••">
                    </div>
                </div>

                <!-- Botão de Login (Simulação) -->
                <button type="button" id="btn-entrar" class="btn-login">
                    Login
                </button>
            </form>

        </div>
    </div>
</main>

