@page "/cadastro"

<CabelhoPagina></CabelhoPagina>

<div class="cadastro-container">
    <h2 class="cadastro-header">
        <i data-lucide="user-plus" class="cadastro-icon"></i>
        Novo Aluno
    </h2>

    <!-- TODO: Adicionar evento 'submit' no código C# para capturar os dados -->
    <form id="form-cadastro" class="cadastro-form">
        <div class="form-group">
            <label class="form-label">Nome do Aluno</label>
            <input type="text" id="nome-aluno" class="form-input">
        </div>

        <div class="form-group">
            <label class="form-label">RA</label>
            <input type="number" id="ra-aluno" class="form-input">
        </div>

        <div class="form-group">
            <label class="form-label">Curso</label>
            <select id="curso-aluno" class="form-select">
                <option value="">Selecione...</option>
                <option>Desenvolvimento de Sistemas</option>
                <option>Eletromecânica</option>
            </select>
        </div>

        <button type="submit" class="btn-cadastro">
            Cadastrar
        </button>
    </form>
</div>

<Rodape></Rodape>

