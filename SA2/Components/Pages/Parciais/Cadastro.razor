@page "/cadastro"

<CabelhoPagina></CabelhoPagina>

<div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-senai-red sticky top-4">
    <h2 class="text-lg font-bold mb-4 flex items-center gap-2 text-senai-dark">
        <i data-lucide="user-plus" class="w-5 h-5 text-senai-red"></i>
        Novo Aluno
    </h2>

    <!-- TODO: Adicionar evento 'submit' no código C# para capturar os dados -->
    <form id="form-cadastro" class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700">Nome do Aluno</label>
            <input type="text" id="nome-aluno" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:border-senai-red focus:ring-senai-red sm:text-sm">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">RA</label>
            <input type="number" id="ra-aluno" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:border-senai-red focus:ring-senai-red sm:text-sm">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Curso</label>
            <select id="curso-aluno" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:border-senai-red focus:ring-senai-red sm:text-sm">
                <option value="">Selecione...</option>
                <option>Desenvolvimento de Sistemas</option>
                <option>Eletromecânica</option>
            </select>
        </div>

        <button type="submit" class="w-full bg-senai-dark text-white py-2 rounded-md hover:bg-black transition">
            Cadastrar
        </button>
    </form>
</div>

<Rodape></Rodape>

