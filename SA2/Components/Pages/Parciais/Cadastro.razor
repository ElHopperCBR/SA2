@page "/cadastro"
@using SA2.Classes.Entidades
@using SA2.Classes.Serv
@using SA2.Data
@inject AlunoService AlunoService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<CabelhoPagina></CabelhoPagina>

<div class="cadastro-container">
    <h2 class="cadastro-header">
        <i data-lucide="user-plus" class="cadastro-icon"></i>
        Novo Aluno
    </h2>

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-error">@mensagemErro</div>
    }

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success">@mensagemSucesso</div>
    }

    <form id="form-cadastro" class="cadastro-form" @onsubmit="CadastrarAluno">
        <div class="form-group">
            <label class="form-label">Nome do Aluno</label>
            <input type="text" id="nome-aluno" class="form-input" @bind="novoAluno.Nome" required>
        </div>

        <div class="form-group">
            <label class="form-label">RA</label>
            <input type="number" id="ra-aluno" class="form-input" @bind="novoAluno.RegistroAluno" required>
        </div>

        <div class="form-group">
            <label class="form-label">Curso</label>
            <select id="curso-aluno" class="form-select" @bind="novoAluno.CursoId" required>
                <option value="0">Selecione...</option>
                @foreach (var cursoItem in curso.Cursos)
                {
                    <option value="@cursoItem.Key">@cursoItem.Value</option>
                }
            </select>
        </div>

        <button type="submit" class="btn-cadastro" disabled="@cadastrando">
            @(cadastrando ? "Cadastrando..." : "Cadastrar")
        </button>
    </form>
</div>

<Rodape></Rodape>

@code {
    private Curso curso = new Curso();
    private Aluno novoAluno = new Aluno();
    private string mensagemErro = string.Empty;
    private string mensagemSucesso = string.Empty;
    private bool cadastrando = false;

    private async Task CadastrarAluno()
    {
        cadastrando = true;
        mensagemErro = string.Empty;
        mensagemSucesso = string.Empty;

        try
        {
            var resultado = await AlunoService.CadastrarAlunoAsync(novoAluno);

            if (resultado.Sucesso)
            {
                mensagemSucesso = resultado.Mensagem;
                await Task.Delay(1000);
                NavigationManager.NavigateTo("/ListaDeAlunos");
            }
            else
            {
                mensagemErro = resultado.Mensagem;
            }
        }
        finally
        {
            cadastrando = false;
        }
    }

    protected override void OnInitialized()
    {
        novoAluno = new Aluno();
    }
}
